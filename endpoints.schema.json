{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cronus Sentinel endpoint config",
  "type": "object",
  "required": [
    "endpoints"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "client_id",
          "endpoint_name"
        ],
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "type": "string",
            "description": "Your internal client slug, e.g. acme-agency"
          },
          "endpoint_name": {
            "type": "string",
            "description": "Human label shown in alerts; unique per client"
          },
          "target_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "telegram_chat_id": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Client's Telegram group/channel ID (groups start with -100)"
          },
          "failure_count": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Seed only; the live counter is kept in .sentinel/state.json"
          },
          "failure_threshold": {
            "type": "integer",
            "minimum": 1,
            "default": 2
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "OPTIONS"
            ],
            "default": "GET"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 250,
            "maximum": 30000,
            "default": 3000
          },
          "expected_status": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "If set, only these codes count as healthy"
          },
          "slack_webhook_url": {
            "type": "string",
            "description": "Optional Slack incoming-webhook URL"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "severity": {
            "type": "string",
            "maxLength": 20,
            "description": "Optional label shown in the alert header, e.g. critical"
          },
          "timezone": {
            "type": "string",
            "description": "Optional IANA time zone; alerts show the client's local time next to UTC, e.g. America/Chicago"
          },
          "runbook_url": {
            "type": "string",
            "pattern": "^https://",
            "description": "Optional; shown as a Runbook button on alerts"
          },
          "dashboard_url": {
            "type": "string",
            "pattern": "^https://",
            "description": "Optional; shown as a Dashboard button on alerts"
          },
          "weekly_summary": {
            "type": "boolean",
            "default": true,
            "description": "Include this endpoint in the client's Monday report"
          },
          "alert_after_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "default": 0,
            "description": "Only alert once the endpoint has been down at least this many minutes (0 = as soon as failure_threshold is reached)"
          },
          "recover_after_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "default": 0,
            "description": "Only send RECOVERED once it has stayed healthy this many minutes; failures in between stay in the same incident (flap protection)"
          },
          "notify": {
            "type": "string",
            "enum": ["alerts", "summary"],
            "default": "alerts",
            "description": "\"summary\" = no real-time incident or recovery cards; outages still appear in the weekly and monthly reports"
          },
          "kind": {
            "type": "string",
            "enum": [
              "http",
              "heartbeat"
            ],
            "default": "http",
            "description": "heartbeat = the client's automation pings us; target_url is filled in automatically"
          },
          "heartbeat_id": {
            "type": "string",
            "pattern": "^hb_[0-9a-f]{24}$",
            "description": "From `python sentinel.py new-heartbeat`; registered in the cronus-forms D1 heartbeats table"
          },
          "expect_every_min": {
            "type": "integer",
            "minimum": 5,
            "description": "How often the automation normally runs; silence for longer (plus 10% grace) is an incident"
          },
          "body_contains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every phrase must appear in the response (case-insensitive)"
          },
          "body_not_contains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "None of these phrases may appear"
          },
          "error_keywords": {
            "type": "boolean",
            "default": false,
            "description": "Also fail on common app-error phrases (fatal error, stack trace, something went wrong, ...)"
          },
          "json_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "e.g. data.items or $.data.items[0].id"
                },
                "rule": {
                  "type": "string",
                  "enum": [
                    "exists",
                    "not_empty",
                    "equals",
                    "not_equals",
                    "min",
                    "max"
                  ],
                  "default": "not_empty"
                },
                "value": {
                  "description": "For equals/not_equals, or a number for min/max (min/max on a list compare its length)"
                }
              }
            }
          },
          "min_body_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "A smaller response body is a failure"
          },
          "size_drop_pct": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "description": "Fail if the body shrinks this % below its usual size (learned after ~1 hour)"
          },
          "monthly_report": {
            "type": "boolean",
            "default": true,
            "description": "Include in the client's branded monthly report"
          },
          "client_name": {
            "type": "string",
            "description": "Client name shown on the monthly report (default client_id)"
          },
          "report_brand": {
            "type": "string",
            "description": "The agency's name; the monthly report is white-labelled with it"
          },
          "report_color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Accent colour for the report"
          },
          "report_logo_url": {
            "type": "string",
            "pattern": "^https://",
            "description": "Agency logo shown on the report"
          },
          "revenue_per_hour": {
            "type": "number",
            "minimum": 0,
            "description": "Optional; the store's average sales per hour, to estimate sales at risk during downtime"
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "heartbeat"
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "required": [
            "client_id",
            "endpoint_name",
            "heartbeat_id",
            "expect_every_min"
          ]
        },
        "else": {
          "required": [
            "client_id",
            "endpoint_name",
            "target_url"
          ]
        },
        "anyOf": [
          {
            "required": [
              "telegram_chat_id"
            ]
          },
          {
            "required": [
              "slack_webhook_url"
            ]
          }
        ]
      }
    }
  }
}
